{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/platform",
      "destination": "/page.html"
    },
    {
      "source": "/solutions",
      "destination": "/page.html"
    },
    {
      "source": "/solutions/ai-workloads",
      "destination": "/page.html"
    },
    {
      "source": "/solutions/gpu-infrastructure",
      "destination": "/page.html"
    },
    {
      "source": "/solutions/ai-data-centers",
      "destination": "/page.html"
    },
    {
      "source": "/solutions/enterprise-ai",
      "destination": "/page.html"
    },
    {
      "source": "/solutions/mission-critical",
      "destination": "/page.html"
    },
    {
      "source": "/technology",
      "destination": "/page.html"
    },
    {
      "source": "/technology/patents",
      "destination": "/page.html"
    },
    {
      "source": "/demo",
      "destination": "/page.html"
    },
    {
      "source": "/customers",
      "destination": "/page.html"
    },
    {
      "source": "/partners",
      "destination": "/page.html"
    },
    {
      "source": "/investors",
      "destination": "/page.html"
    },
    {
      "source": "/about",
      "destination": "/page.html"
    },
    {
      "source": "/contact",
      "destination": "/page.html"
    }
  ],
  "redirects": [
    {
      "source": "/privacy",
      "destination": "/legal#privacy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/legal#terms",
      "permanent": true
    },
    {
      "source": "/page",
      "destination": "/platform",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}